  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryUpdate": {
        "properties": {
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$"
              }
            ],
            "title": "Quantity"
          },
          "daily_usage": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$"
              }
            ],
            "title": "Daily Usage"
          },
          "threshold_days": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 365.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$"
              }
            ],
            "title": "Threshold Days"
          },
          "purchase_quantity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$"
              }
            ],
            "title": "Purchase Quantity"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity",
          "daily_usage",
          "threshold_days",
          "purchase_quantity",
          "expected_version",
          "reason"
        ],
        "title": "InventoryUpdate"
      },
      "MonitorRequest": {
        "properties": {
          "item_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Item Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id"
        ],
        "title": "MonitorRequest"
      },
      "OfferUpdate": {
        "properties": {
          "unit_price_sen": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Unit Price Sen"
          },
          "lead_days": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 365.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$"
              }
            ],
            "title": "Lead Days"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unit_price_sen",
          "lead_days",
          "expected_version",
          "reason"
        ],
        "title": "OfferUpdate"
      },
      "Resolution": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "cancel"
            ],
            "title": "Action"
          },
          "option_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Option Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Reason"
          },
          "acknowledge_risk": {
            "type": "boolean",
            "title": "Acknowledge Risk",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "Resolution"
      },
      "ScenarioRequest": {
        "properties": {
          "template": {
            "type": "string",
            "enum": [
              "delivery_delay",
              "price_change"
            ],
            "title": "Template",
            "default": "delivery_delay"
          },
          "item_id": {
            "type": "string",
            "maxLength": 40,
            "title": "Item Id",
            "default": "milk"
          },
          "delay_days": {
            "type": "integer",
            "maximum": 14.0,
            "minimum": 1.0,
            "title": "Delay Days",
            "default": 3
          },
          "price_change_percent": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": -30.0,
            "title": "Price Change Percent",
            "default": 10
          },
          "rounds": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Rounds",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScenarioRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
